# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible endpoint. The harness reads only these three variables.
LLM_BASE_URL=https://your-endpoint.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=Qwen/Qwen3-8B

# Only needed if you deploy infra/modal_vllm.py. Store the same value in the
# Modal secret "sleep-evolve-vllm" (key VLLM_API_KEY) and reuse it as LLM_API_KEY.
VLLM_API_KEY=replace-me
