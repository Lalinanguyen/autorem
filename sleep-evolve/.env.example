# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible endpoint. The endpoint is configured ONLY by these three variables.
# Default for the experiment (configs/*_openai.yaml): the OpenAI API.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
# Must match the config's `model` (run_matrix refuses otherwise):
#   gpt-5-nano for configs/debug_openai.yaml, gpt-5-mini for configs/pilot_openai.yaml and baselines_openai.yaml
LLM_MODEL=gpt-5-mini

# Optional request-parameter fallbacks (llm/chat_params.py). A non-null value in the config's `llm:`
# block wins over these; unset = auto-detection by model name (gpt-5* / o-series: max_completion_tokens,
# no temperature; other models: max_tokens). The *_openai.yaml configs set reasoning_effort: low.
# LLM_TOKEN_PARAM=auto              # auto | max_tokens | max_completion_tokens
# LLM_REASONING_EFFORT=low          # none | minimal | low | medium | high | xhigh | max (model-dependent)
# LLM_TEMPERATURE=                  # only sent to models that accept it
# LLM_REASONING_MODEL=              # true | false; overrides the name-based detection
# LLM_THINKING=                     # true | false; vLLM/Qwen only -> chat_template_kwargs enable_thinking

# Fallback backend: self-hosted vLLM on Modal (infra/modal_vllm.py). Then set
#   LLM_BASE_URL=https://<workspace>--sleep-evolve-vllm-serve.modal.run/v1, LLM_MODEL=Qwen/Qwen3-8B
# and store the same key in the Modal secret "sleep-evolve-vllm" (key VLLM_API_KEY), reused as LLM_API_KEY.
VLLM_API_KEY=replace-me
